<!-- avatar_circle_background.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Background warna putih untuk lingkaran -->
    <solid android:color="@android:color/white" />

    <!-- Garis tepi lingkaran -->
    <stroke
        android:width="4dp"
        android:color="@android:color/black" />

    <!-- Padding di dalam lingkaran -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />

</shape>
