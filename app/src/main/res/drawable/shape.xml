<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#FFFFFF"/> <!-- Warna latar belakang -->

    <!-- Membuat bevel/rounded corner -->
    <corners android:radius="22dp"/>

    <!-- Membuat garis tepi/stroke -->
    <stroke
        android:width="2dp"
        android:color="#6AAA2C"/> <!-- Warna hijau sesuai tombol -->

    <!-- Membuat padding internal -->
    <padding
        android:left="4dp"
        android:right="4dp"
        android:top="4dp"
        android:bottom="4dp"/>
</shape>
