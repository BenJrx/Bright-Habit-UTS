<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <!-- Shadow Effect -->
        <shape
            android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="16dp"/>
            <padding
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp"/>
            <solid android:color="#60000000"/> <!-- Semi-transparent shadow color -->
        </shape>
    </item>
    <item>
        <!-- Background Color -->
        <shape
            android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
